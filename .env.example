# Falix 自动验证容器配置 —— 复制成 .env 再填（.env 已进 .gitignore，不要提交真实值）
# 必填：Falix API Key（权限 servers:read + servers:power）
FALIX_API_KEY=
# 服务器 ID，默认 3564044（qawqaw）
SERVER_ID=3564044
# 代理：填一条代理链接（hysteria2:// / vless:// / vmess:// / tuic:// /
# anytls:// / trojan:// / ss://），由 setup_proxy.py 转成本地 127.0.0.1:1080
NODE_LINK=
# 或直接填普通代理地址（http:// / socks5://）
# PROXY_SERVER=
# 可选：Telegram 通知
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# 每轮检查间隔（秒），默认 1800（30 分钟）
CHECK_INTERVAL=1800
